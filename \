Terraform Task - Security Group with EC2 (t3.micro3) 

provider "aws" {
      region = "ap-south-1"
  }


resource "aws_security_group" "himanshi_sg" {
    name             = "himanshi-shh-sg"
    description      = "Allow SSH to my server"        }


    ingress {
         from_port   = 22 
         to_port     = 22 
         protocol    = "tcp"
         cidr_blocks = ["0.0.0.0/0"]
} 
    }



resource "aws_instance" "himanshi_web"
    ami                    = "ami-0abcd1234bcd1234"
    instance_type          = "t3.micro"
    vpc_security_group_ids = [aws_security_group.himanshi_sg.id]

    tags = {        
      Name = "himanshi-ec2"
      } 
 }


